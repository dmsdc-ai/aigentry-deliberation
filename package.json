{
  "name": "@dmsdc-ai/aigentry-deliberation",
  "version": "0.0.47",
  "description": "MCP server for structured multi-AI discussions — deliberate across Claude, GPT, Gemini and more before committing to decisions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmsdc-ai/aigentry-deliberation.git"
  },
  "homepage": "https://github.com/dmsdc-ai/aigentry-deliberation#readme",
  "bugs": {
    "url": "https://github.com/dmsdc-ai/aigentry-deliberation/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "index.js",
  "bin": {
    "aigentry-deliberation": "index.js",
    "mcp-deliberation": "index.js",
    "deliberation-install": "install.js",
    "deliberation-doctor": "doctor.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "i18n.js",
    "model-router.js",
    "clipboard.js",
    "install.js",
    "doctor.js",
    "browser-control-port.js",
    "degradation-state-machine.js",
    "logger-emit.js",
    "session-monitor.sh",
    "session-monitor-win.js",
    "selectors/**",
    "skills/**",
    "lib/**",
    "examples/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "vitest run",
    "postversion": "node install.js",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "dependencies": {
    "@dmsdc-ai/aigentry-logger": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "mcp",
    "deliberation",
    "ai",
    "multi-agent",
    "debate",
    "discussion",
    "consensus",
    "claude",
    "chatgpt",
    "gemini",
    "codex",
    "model-context-protocol",
    "structured-output"
  ],
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
